{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "stripInternal": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "es5",
      "es2015.collection",
      "es2015.iterable",
      "es2015.generator",
      "es2015.promise",
      "es2015.symbol",
      "es2024.promise",
      "esnext.typedarrays",
      "dom"
    ]
  },
  "include": ["src"]
}
